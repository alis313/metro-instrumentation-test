# Database - Neon PostgreSQL (get from https://neon.tech)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# JWT secret for session tokens (generate a random 32+ char string)
JWT_SECRET=change-me-to-a-random-secret

# Cookie secure flag (set to 1 when behind HTTPS in production)
COOKIE_SECURE=1

# Vercel Blob storage (for file uploads - get from Vercel dashboard)
BLOB_READ_WRITE_TOKEN=
